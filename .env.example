# --- API server (apps/api) ---
# Anthropic key for the LLM opponent. Keep this server-side only; it is never
# sent to the browser. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional API overrides:
# PORT=8787
# DB_PATH=marrakech.db
# WEB_ORIGIN=http://localhost:5173   # CORS allow-list (set to your Vercel URL in prod)

# --- Web app (root) ---
# Where the browser reaches the API. Defaults to http://localhost:8787 if unset.
VITE_API_URL=http://localhost:8787
