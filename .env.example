# --- API server (apps/api) ---
# The LLM opponent's key stays server-side only; it is never sent to the browser.
#
# Pick a provider with LLM_PROVIDER (default: openai). Set ONLY the block you use.

# LLM_PROVIDER=openai   (default) — any OpenAI-compatible endpoint:
#   OpenAI, DeepSeek, or most third-party gateways that speak /chat/completions.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL: the endpoint. Omit for OpenAI's own https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   gateway:   https://your-gateway.example.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL: the model id for that endpoint.
#   DeepSeek:  deepseek-chat        OpenAI: gpt-4o-mini
OPENAI_MODEL=deepseek-chat

# LLM_PROVIDER=anthropic — the official Anthropic API instead.
#   ANTHROPIC_API_KEY=sk-ant-...

# Optional API overrides:
# PORT=8787
# DATABASE_URL=postgresql://...      # Neon/Postgres connection string (used on Render)
# DB_PATH=marrakech.db               # Local SQLite fallback when DATABASE_URL is unset
# ONLINE_DB_PATH=marrakech-online.db # Local SQLite online fallback when DATABASE_URL is unset
# WEB_ORIGIN=http://localhost:5173   # CORS allow-list (set to your Vercel URL in prod)

# --- Web app (root) ---
# Where the browser reaches the API for online multiplayer and AI features.
# Defaults to http://localhost:8787 if unset; use the deployed HTTPS API in production.
VITE_API_URL=http://localhost:8787
